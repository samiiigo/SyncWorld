# ──────────────────────────────────────────────
# SyncWorld app — environment configuration
# Copy to .env (git-ignored) and fill in values. Expo only exposes variables
# prefixed with EXPO_PUBLIC_ to the app, and they are inlined at build time —
# never put server secrets (Gemini key, service accounts) in this file.
# ──────────────────────────────────────────────

# development | staging | production
EXPO_PUBLIC_ENVIRONMENT=development

# true  = simulated rooms/members, no backend needed (UI work, demos)
# false = real Firebase + realtime server
# Unset = demo mode only when no Firebase config and no emulators are configured.
EXPO_PUBLIC_DEMO_MODE=

# ── Firebase (Firebase console → Project settings → Your apps → Web app) ──
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-syncworld
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Web push for the Windows/Mac web build (Cloud Messaging → Web Push certificates)
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# ── Local development against the Firebase emulator suite ──
# Defaults to true when ENVIRONMENT=development.
EXPO_PUBLIC_USE_EMULATORS=
# localhost for web/iOS simulator, 10.0.2.2 for the Android emulator,
# your computer's LAN IP for a physical phone.
EXPO_PUBLIC_EMULATOR_HOST=localhost
# Only if the default emulator ports (9099 / 8085 / 5001) are taken:
EXPO_PUBLIC_AUTH_EMULATOR_PORT=
EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=
EXPO_PUBLIC_FUNCTIONS_EMULATOR_PORT=

# ── Realtime server (syncworld-backend/realtime-server) ──
EXPO_PUBLIC_SOCKET_SERVER_URL=http://localhost:3000
